# Server
PORT=3000
NODE_ENV=development

# MongoDB (set USE_MONGO=true to enable)
USE_MONGO=false
MONGODB_URI=mongodb://localhost:27017/joybor

# JWT
JWT_SECRET=your-strong-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_MAX=200

# Redis (set REDIS_ENABLED=true to enable)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
