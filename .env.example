# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/joybor
USE_MONGO=false

# JWT (PRODUCTION: JWT_SECRET ni openssl rand -hex 32 bilan generatsiya qiling)
# JWT_SECRET=  # MUHIM: Bu yerda secret saqlanmaydi, env orqali uzatilsin
JWT_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# CORS (PRODUCTION: aniq domenni kiriting, masalan: https://makon.uz)
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
