# ─── Server ────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/makon
USE_MONGO=true

# ─── JWT (PRODUCTION: openssl rand -hex 32 bilan generatsiya qiling) ─
# JWT_SECRET=  
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_refresh_secret_for_development
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# ─── CORS (PRODUCTION: aniq domenni kiriting) ────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── Rate Limiting ────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Sentry (optional) ───────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENABLED=false

# ─── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=debug
