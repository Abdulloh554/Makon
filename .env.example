# ─── Server ────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/makon
USE_MONGO=true

# ─── JWT (PRODUCTION: openssl rand -hex 32 bilan generatsiya qiling) ─
# JWT_SECRET=  
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_refresh_secret_for_development
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# ─── CORS (PRODUCTION: aniq domenni kiriting) ────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── Rate Limiting ────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Sentry (optional) ───────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENABLED=false

# ─── Firebase Admin SDK (optional) ───────────────────────────────────
# Firebase Admin SDK for verifying Firebase Auth idTokens
# Service account credentials — get from Firebase Console > Project Settings > Service Accounts
# FIREBASE_PROJECT_ID=makon-c46d2
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@makon-c46d2.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=debug
